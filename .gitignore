# Create .gitignore file
cat > .gitignore << EOF
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.egg-info/

# Virtual Environment
.env
.venv
venv/
ENV/
env/
myenv/
virtualenv/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# Database
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Project specific
*.bak
*.pid
EOF