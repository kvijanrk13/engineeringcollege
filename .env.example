# ================================
# Django Settings
# ================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Debug mode (set to False in production)
DEBUG=False

# ================================
# Database (Neon PostgreSQL)
# ================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ================================
# Cloudinary Configuration
# ================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ================================
# Google OAuth (for MOOCS sign-in)
# ================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ================================
# Email Settings
# ================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=ecprj2026@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ================================
# Razorpay Payment Gateway (for MOOCS Set 3 access)
# ================================
# Get these from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ================================
# MOOCS Settings
# ================================
MOOCS_SET_3_ACCESS_FEE=200

# ================================
# MOOCS Payment Whitelisting (bypass Razorpay for specific accounts)
# ================================
# Comma-separated list of email addresses that skip the Set 3 Razorpay payment
# and get immediate access to all sets 3 through 200.
# MOOCS_PAYMENT_WHITELIST=vijaykumarit@anurag.ac.in

# Set to "True" to bypass the Razorpay payment for ALL authenticated MOOCS
# users (gives every signed-in user immediate access to sets 3-200).
# MOOCS_PAYMENT_BYPASS_ALL=True

# ================================
# Django Superuser (for admin access)
# ================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
