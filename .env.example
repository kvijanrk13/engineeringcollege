# Django Settings
DEBUG=False
SECRET_KEY=your-50-plus-character-random-secret-key-here-generate-with-openssl-rand-base64-48

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=engineeringcollege.onrender.com,kvkprojects.onrender.com,anrkitdept.onrender.com

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://engineeringcollege.onrender.com,https://kvkprojects.onrender.com,https://anrkitdept.onrender.com

# Admin URL (change this to a random string for security)
ADMIN_URL=admin-panel-secure-2026/

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth (optional)
GOOGLE_MAPS_API_KEY=your-api-key
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Razorpay (optional)
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# College Settings
COLLEGE_NAME=Engineering College
DEPARTMENT_NAME=Information Technology
ACADEMIC_YEAR=2026-2027