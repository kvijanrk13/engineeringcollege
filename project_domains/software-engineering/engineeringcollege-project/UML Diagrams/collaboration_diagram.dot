graph collaboration_diagram {
  graph [
    label="COLLABORATION DIAGRAM\nEngineeringCollege Project - Faculty / Student Document Flow",
    labelloc=t,
    fontsize=32,
    fontname="Arial",
    layout=neato,
    overlap=false,
    bgcolor="white",
    splines=true,
    sep="+1.1"
  ];
  node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f8fbff", color="#2f5597", penwidth=1.6];
  edge [fontname="Arial", fontsize=11, color="#4f5b66", penwidth=1.2];

  User [label=":User\nAdmin / Faculty / Student", pos="0,3!"];
  Browser [label=":Browser", pos="2.2,4!"];
  Views [label=":dashboard.views", pos="4.5,3!"];
  Models [label=":Django Models\nFaculty, Student, Certificate", pos="4.4,1!"];
  PDF [label=":PDF Service\nWeasyPrint / ReportLab / pypdf", pos="7,3!"];
  Storage [label=":Cloudinary / Media Storage", pos="7,1!"];
  Database [label=":PostgreSQL Database", pos="2,0.8!"];

  User -- Browser [label="1. fill forms / request PDF"];
  Browser -- Views [label="2. HTTP request"];
  Views -- Models [label="3. create / update objects"];
  Models -- Database [label="4. persist records"];
  Views -- PDF [label="5. build profile PDF"];
  PDF -- Models [label="6. read document fields"];
  PDF -- Storage [label="7. fetch photo and certificates"];
  PDF -- Storage [label="8. upload merged PDF"];
  Views -- Browser [label="9. redirect / stream response"];
  Browser -- User [label="10. display result"];
}
