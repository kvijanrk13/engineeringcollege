@startuml 21_Use_Case_Diagram_Student
' Engineering College - Use Case Diagram for STUDENT Module
' A4 Page Layout

title Engineering College - STUDENT Module Use Case Diagram

left to right direction

actor "Student" as Student

rectangle "Engineering College System" {
    usecase "Login to Student Portal" as UC1
    usecase "View Student Dashboard" as UC2
    usecase "View Personal Profile" as UC3
    usecase "View Academic Information" as UC4
    usecase "Upload Certificates" as UC5
    usecase "Manage Research Publications" as UC6
    usecase "View Syllabus" as UC7
    usecase "View Gallery" as UC8
    usecase "View Exam Branch Data" as UC9
    usecase "Generate Profile PDF" as UC10
    usecase "Download Certificates" as UC11
    usecase "Logout" as UC12
    
    UC3 <.. UC1 : <<include>>
    UC4 <.. UC1 : <<include>>
    UC5 <.. UC1 : <<include>>
    UC6 <.. UC1 : <<include>>
    UC7 <.. UC1 : <<include>>
    UC8 <.. UC1 : <<include>>
    UC10 <.. UC5 : <<extend>>
    UC11 <.. UC5 : <<extend>>
}

Student --> UC1
Student --> UC2

@enduml