digraph deployment_diagram {
  graph [
    label="DEPLOYMENT DIAGRAM\nEngineeringCollege Project",
    labelloc=t,
    fontsize=32,
    fontname="Arial",
    rankdir=LR,
    bgcolor="white",
    splines=ortho,
    nodesep=0.6,
    ranksep=0.9
  ];
  node [fontname="Arial", fontsize=13, shape=box3d, style="filled", fillcolor="#f8fbff", color="#2f5597", penwidth=1.6];
  edge [fontname="Arial", fontsize=11, color="#4f5b66", arrowsize=0.8];

  Client [label="Client Device\nBrowser / Mobile Web"];
  Render [label="Render Web Service\nGunicorn + Django"];
  Static [label="Static Files\nWhiteNoise / staticfiles"];
  Media [label="Media Storage\nLocal media during runtime"];
  Cloudinary [label="Cloudinary\nPhotos, certificates, PDFs"];
  Postgres [label="PostgreSQL / Neon\nApplication database"];
  GitHub [label="GitHub Repository\nSource and deployment trigger"];

  subgraph cluster_render {
    label="EngineeringCollege Deployment Boundary";
    fontname="Arial";
    fontsize=18;
    color="#8faadc";
    style="rounded";
    Render;
    Static;
    Media;
  }

  Client -> Render [label="HTTPS requests"];
  Render -> Static [label="serve assets"];
  Render -> Media [label="read/write temporary files"];
  Render -> Cloudinary [label="upload / download documents"];
  Render -> Postgres [label="Django ORM"];
  GitHub -> Render [label="auto deploy from main"];
}
