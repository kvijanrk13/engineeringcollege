@startuml
title SEQUENCE DIAGRAM\nEngineeringCollege Project - Student Profile & PDF Generation (Page 2 of 2)

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam titleFontSize 32
skinparam titleFontStyle bold
skinparam sequence {
  ArrowColor #4F5B66
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #2F5597
  ParticipantBackgroundColor #D9EAF7
}

actor "Admin" as Admin
actor "Student" as Student
participant "Browser" as Browser
participant "dashboard.views" as View
participant "Student Model" as StudentModel
participant "Certificate Model" as CertModel
participant "PDF Service\n(WeasyPrint / ReportLab)" as PDF
participant "Media / Cloud Storage" as Storage
participant "HTTP Response" as Response

Student -> Browser : 11. Login & view profile
Browser -> View : 12. GET student_detail
View -> StudentModel : 13. Fetch student record
StudentModel --> View : 14. Return student data
View -> CertModel : 15. Fetch certificates
CertModel --> View : 16. Return cert list
View --> Browser : 17. Render detail page
Browser -> Student : 18. View complete profile
Student -> Browser : 19. Click Generate PDF
Browser -> View : 20. GET generate_student_pdf
View -> StudentModel : 21. Read student data
StudentModel --> View : 22. Return fields + photo_url
View -> CertModel : 23. Fetch all certificates
CertModel --> View : 24. Return certificate list
View -> PDF : 25. generate_student_pdf(student)
PDF -> StudentModel : 26. Read local & cloud assets
PDF -> Storage : 28. Fetch photos & certificates
Storage --> PDF : 29. Asset data
PDF -> PDF : 30. Render HTML + WeasyPrint
PDF -> PDF : 31. Merge certificate PDFs
PDF -> Storage : 32. Store generated PDF
Storage --> PDF : 33. PDF file path / URL
PDF -> StudentModel : 34. Persist pdf_url + pdf_generated
StudentModel --> PDF : 35. Updated record
PDF --> View : 36. PDF ready
View -> Response : 37. Stream PDF or redirect
Response --> Browser : 38. Show PDF/download
Browser -> Student : 39. Download confirmation
@enduml