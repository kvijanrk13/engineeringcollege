@startuml
title USE CASE DIAGRAM\nEngineeringCollege Django Project

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 26
skinparam titleFontStyle bold
skinparam usecase {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  ArrowColor #4F5B66
  FontSize 12
}
skinparam actor {
  BorderColor #2F5597
  BackgroundColor white
  FontSize 13
  FontStyle bold
}

left to right direction

actor "Admin" as Admin
actor "Faculty" as Faculty
actor "Student" as Student
actor "Visitor" as Visitor

rectangle "EngineeringCollege Django System" {
  usecase "Manage Faculty\nProfiles" as UC_AdminFaculty
  usecase "Manage Student\nProfiles" as UC_AdminStudent
  usecase "Assign Subjects" as UC_AssignSubjects
  usecase "Bulk Faculty\nActions" as UC_BulkFaculty
  usecase "Bulk Student\nActions" as UC_BulkStudent
  usecase "Cloudinary Sync" as UC_Cloudinary
  usecase "Exam Branch\nManagement" as UC_ExamBranch
  usecase "System\nAdministration" as UC_SystemAdmin
  usecase "Manage\nCertificates" as UC_CertAdmin
  usecase "Approve\nPayments" as UC_PaymentAdmin
  usecase "View\nAnalytics" as UC_Analytics

  usecase "Faculty\nProfile Management" as UC_FacultyProfile
  usecase "Upload\nDocuments" as UC_FacultyUpload
  usecase "Generate\nFaculty PDF" as UC_FacultyPDF
  usecase "Research\nPublications" as UC_Research
  usecase "FDP/\nWorkshops" as UC_FDP
  usecase "B.Tech\nProjects" as UC_BTech
  usecase "Faculty\nCertificates" as UC_FacultyCerts

  usecase "Student\nProfile Management" as UC_StudentProfile
  usecase "Upload Student\nCertificates" as UC_StudentUpload
  usecase "Generate\nStudent PDF" as UC_StudentPDF
  usecase "Merge Student\nCertificates" as UC_MergeCerts

  usecase "View Gallery" as UC_Gallery
  usecase "View Projects/\nDomains" as UC_Projects
  usecase "Download\nProject ZIP" as UC_Download
  usecase "View Exam\nBranch" as UC_Exam
  usecase "View\nSubjects" as UC_Subjects
  usecase "Car Price\nPrediction" as UC_CarPrice
}

Admin --> UC_AdminFaculty
Admin --> UC_AdminStudent
Admin --> UC_AssignSubjects
Admin --> UC_BulkFaculty
Admin --> UC_BulkStudent
Admin --> UC_Cloudinary
Admin --> UC_ExamBranch
Admin --> UC_SystemAdmin
Admin --> UC_CertAdmin
Admin --> UC_PaymentAdmin
Admin --> UC_Analytics

Faculty --> UC_FacultyProfile
Faculty --> UC_FacultyUpload
Faculty --> UC_FacultyPDF
Faculty --> UC_Research
Faculty --> UC_FDP
Faculty --> UC_BTech
Faculty --> UC_FacultyCerts

Student --> UC_StudentProfile
Student --> UC_StudentUpload
Student --> UC_StudentPDF
Student --> UC_MergeCerts

Visitor --> UC_Gallery
Visitor --> UC_Projects
Visitor --> UC_Download
Visitor --> UC_Exam
Visitor --> UC_Subjects
Visitor --> UC_CarPrice

UC_FacultyUpload ..> UC_FacultyPDF : <<include>>
UC_StudentUpload ..> UC_StudentPDF : <<include>>
UC_Research ..> UC_FacultyPDF : <<include>>
UC_Projects ..> UC_Download : <<extend>>
@enduml