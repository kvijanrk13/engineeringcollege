@startuml
title STATE CHART DIAGRAM\nEngineeringCollege Project - Project Download Payment

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 26
skinparam titleFontStyle bold
skinparam state {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  StartColor #2F5597
  EndColor #2F5597
  FontSize 12
}

[*] --> CREATED : initiate payment

state CREATED {
  CREATED : Order initialized
  CREATED : merchant_order_id generated
}

CREATED --> PENDING : PhonePe checkout created
CREATED --> FAILED : payment service error

state PENDING {
  PENDING : Payment URL / QR generated
  PENDING : Awaiting verification
}

PENDING --> COMPLETED : payment success
PENDING --> FAILED : verification failed / timeout
PENDING --> CREATED : retry

state COMPLETED {
  COMPLETED : Payment verified & approved
  COMPLETED : Delivery link prepared
}

COMPLETED --> DELIVERED : admin provides drive link

state DELIVERED {
  DELIVERED : ZIP project delivered
  DELIVERED : download_count incremented
}

DELIVERED --> DELIVERED : repeat download
DELIVERED --> [*]

state FAILED {
  FAILED : Payment validation failed
  FAILED : User may retry
}

FAILED --> LOCKED : invalid / blocked

state LOCKED {
  LOCKED : Download denied
}

LOCKED --> [*]
@enduml