digraph sequence_diagram {
  graph [
    label="SEQUENCE DIAGRAM\nEngineeringCollege Project - Student PDF Generation",
    labelloc=t,
    fontsize=32,
    fontname="Arial",
    rankdir=TB,
    bgcolor="white",
    splines=polyline,
    nodesep=0.6,
    ranksep=0.75
  ];
  node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f8fbff", color="#2f5597", penwidth=1.6];
  edge [fontname="Arial", fontsize=11, color="#4f5b66", arrowsize=0.8];

  subgraph cluster_participants {
    label="";
    color="white";
    rank=same;
    Student [label="Student"];
    Browser [label="Browser"];
    DjangoView [label="dashboard.views"];
    StudentModel [label="Student Model"];
    PDFService [label="PDF / Merge Service"];
    Cloudinary [label="Cloudinary Storage"];
    Response [label="HTTP Response"];
  }

  Student -> Browser [label="1. submit profile / certificates"];
  Browser -> DjangoView [label="2. POST add_student / edit_student"];
  DjangoView -> StudentModel [label="3. validate and save fields"];
  StudentModel -> DjangoView [label="4. saved student id"];
  DjangoView -> PDFService [label="5. generate_student_pdf(student)"];
  PDFService -> StudentModel [label="6. read photo and certificate fields"];
  PDFService -> Cloudinary [label="7. download remote assets"];
  Cloudinary -> PDFService [label="8. asset bytes / URLs"];
  PDFService -> PDFService [label="9. render profile and merge certificates"];
  PDFService -> Cloudinary [label="10. upload merged PDF"];
  Cloudinary -> PDFService [label="11. secure PDF URL"];
  PDFService -> StudentModel [label="12. persist pdf_url / pdf_file"];
  PDFService -> DjangoView [label="13. PDF generated"];
  DjangoView -> Response [label="14. redirect or stream PDF"];
  Response -> Browser [label="15. show student detail / PDF"];
  Browser -> Student [label="16. confirmation"];

  Student_life [shape=plaintext, label="|"];
  Browser_life [shape=plaintext, label="|"];
  Django_life [shape=plaintext, label="|"];
  Model_life [shape=plaintext, label="|"];
  PDF_life [shape=plaintext, label="|"];
  Cloud_life [shape=plaintext, label="|"];
  Response_life [shape=plaintext, label="|"];

  Student -> Student_life [style=invis];
  Browser -> Browser_life [style=invis];
  DjangoView -> Django_life [style=invis];
  StudentModel -> Model_life [style=invis];
  PDFService -> PDF_life [style=invis];
  Cloudinary -> Cloud_life [style=invis];
  Response -> Response_life [style=invis];
}
