@startuml
title SEQUENCE DIAGRAM\nEngineeringCollege Project - Student Profile & PDF Generation (Page 1 of 2)

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam titleFontSize 32
skinparam titleFontStyle bold
skinparam sequence {
  ArrowColor #4F5B66
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #2F5597
  ParticipantBackgroundColor #D9EAF7
}

actor "Admin" as Admin
actor "Student" as Student
participant "Browser" as Browser
participant "dashboard.views" as View
participant "Student Model" as StudentModel
participant "Certificate Model" as CertModel
participant "PDF Service\n(WeasyPrint / ReportLab)" as PDF
participant "Media / Cloud Storage" as Storage
participant "HTTP Response" as Response

Admin -> Browser : 1. Navigate to Add Student
Browser -> View : 2. GET add_student
View --> Browser : 3. Render form
Browser -> Admin : 4. Show form
Admin -> Browser : 5. Submit student data
Browser -> View : 6. POST add_student
View -> StudentModel : 7. Validate & save
StudentModel --> View : 8. Student saved
View --> Browser : 9. Redirect to student_detail
Browser -> Admin : 10. Confirmation
@enduml