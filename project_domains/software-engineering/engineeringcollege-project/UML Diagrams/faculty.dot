  // Cli Options: dashboard --dot -I Subject,Faculty,FacultyProfile,Certificate,FacultyLog,CloudinaryUpload,ResearchProject,ResearchPublication,FDP,BTechProject -o project_domains\software-engineering\engineeringcollege-project\UML Diagrams\faculty.dot

  fontname = "Arial"
  fontsize = 24
  splines  = true
  rankdir = "TB"
  

  node [
