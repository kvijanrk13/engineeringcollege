@startuml
title DEPLOYMENT DIAGRAM\nEngineeringCollege Django Project - Page 1

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam titleFontSize 32
skinparam titleFontStyle bold
skinparam node {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 26
}
skinparam database {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 26
}
skinparam cloud {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 26
}
skinparam component {
  BorderColor #2F5597
  BackgroundColor white
  FontSize 24
}
skinparam artifact {
  BorderColor #2F5597
  BackgroundColor white
  FontSize 24
}
skinparam ArrowColor #4F5B66

node "Client Device\nBrowser / Mobile Web" as Client {
  component "Django Templates\n(HTML/CSS/JS)" as Templates
  component "Static Assets\n(images, CSS, JS)" as StaticAssets
}

cloud "Render Cloud Platform\n(render.com)" as Render {
  node "Django Application\n(Gunicorn / Python)" as DjangoApp {
    component "dashboard app" as dashboard
    component "engineeringcollege\nproject config" as project
  }
  artifact "Static Files\nWhiteNoise / staticfiles" as StaticFiles
  artifact "Media Files\nruntime uploads" as MediaFiles
}

cloud "Cloudinary\nPhotos, certificates, PDFs" as CloudStorage

Client --> Render : HTTPS (443)
Render --> CloudStorage : Upload / Download documents
DjangoApp --> StaticFiles : serve assets
DjangoApp --> MediaFiles : read / write runtime
@enduml