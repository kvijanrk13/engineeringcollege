@startuml
title DEPLOYMENT DIAGRAM\nEngineeringCollege Django Project

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 26
skinparam titleFontStyle bold
skinparam node {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 12
}
skinparam database {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 12
}
skinparam cloud {
  BorderColor #2F5597
  BackgroundColor #F8FBFF
  FontSize 12
}
skinparam component {
  BorderColor #2F5597
  BackgroundColor white
  FontSize 11
}
skinparam artifact {
  BorderColor #2F5597
  BackgroundColor white
  FontSize 11
}
skinparam ArrowColor #4F5B66

' Client
node "Client Device\nBrowser / Mobile Web" as Client {
  component "Django Templates\n(HTML/CSS/JS)" as Templates
  component "Static Assets\n(images, CSS, JS)" as StaticAssets
}

' Web Server / Platform
cloud "Render Cloud Platform\n(render.com)" as Render {
  node "Django Application\n(Gunicorn / Python)" as DjangoApp {
    component "dashboard app" as dashboard
    component "car_price_app\nGmail OAuth protected\nML Demo" as car_app
    component "engineeringcollege\nproject config" as project
  }
  artifact "Static Files\nWhiteNoise / staticfiles" as StaticFiles
  artifact "Media Files\nruntime uploads" as MediaFiles
}

' Database
database "PostgreSQL / Neon\nApplication Database" as Postgres {
  component "Dashboard\nModels" as DBModels
}

' External Services
cloud "Cloudinary\nPhotos, certificates, PDFs" as CloudStorage
cloud "PhonePe Gateway\nPayment Processing" as PhonePe
node "GitHub Repository" as GitHub within "Source Control"

' Connections
Client --> Render : HTTPS (443)
Render --> Postgres : Django ORM
Render --> CloudStorage : Upload / Download documents
Render --> PhonePe : Payment API
DjangoApp --> StaticFiles : serve assets
DjangoApp --> MediaFiles : read / write runtime
GitHub --> Render : auto deploy from main
@enduml