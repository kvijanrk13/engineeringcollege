digraph library_app {
	bgcolor=white dpi=150 rankdir=TB
	node [color=black fontname=Arial fontsize=10 shape=record]
	edge [color=black fontname=Arial fontsize=9]
	Author [label="{Author|+ id : BigInteger\l+ name : Varchar(350)\l+ description : Varchar(450)\l+ __str__() : String\l}"]
	Book [label="{Book|+ id : BigInteger\l+ name : Varchar(350)\l+ image : ImageField\l+ category : Varchar(220)\l+ __str__() : String\l+ cloudinary_image_url() : String\l}"]
	Issue [label="{Issue|+ id : BigInteger\l+ created_at : DateTime\l+ issued : Boolean\l+ issued_at : DateTime\l+ returned : Boolean\l+ return_date : DateTime\l+ __str__() : String\l+ days_no() : String\l}"]
	Fine [label="{Fine|+ id : BigInteger\l+ amount : Decimal(10,2)\l+ paid : Boolean\l+ order_id : Varchar(500)\l+ datetime_of_payment : DateTime\l+ razorpay_order_id : Varchar(500)\l+ razorpay_payment_id : Varchar(500)\l+ razorpay_signature : Varchar(500)\l+ save()\l+ __str__() : String\l}"]
	LibraryStat [label="{LibraryStat|+ id : BigInteger\l+ borrowed_books : PositiveInteger\l+ __str__() : String\l}"]
	BookRecommendation [label="{BookRecommendation|+ id : BigInteger\l+ image : ImageField\l+ title : Varchar(350)\l+ author : Varchar(350)\l+ book_type : TextField\l+ isbn : Varchar(50)\l+ publisher : Varchar(200)\l+ edition_year : Varchar(50)\l+ book_format : Varchar(10)\l+ copies_recommended : Varchar(20)\l+ existing : Varchar(20)\l+ cost : Varchar(50)\l+ created_at : DateTime\l+ __str__() : String\l}"]
	Author -> Book [label=1 arrowhead=none style=solid]
	Book -> Issue [label=1 arrowhead=none style=solid]
	Issue -> Fine [label="0..1" arrowhead=none style=solid]
}
