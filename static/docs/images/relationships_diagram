digraph relationships {
	bgcolor=white dpi=150 rankdir=TB
	node [color=black fillcolor="#E8E8E8" fontname=Arial fontsize=10 shape=box style="rounded,filled"]
	edge [color=black fontname=Arial fontsize=9 style=solid]
	subgraph cluster_library {
		color=black fillcolor="#F0F0F0" fontname=Arial fontsize=12 label="Library App" style="rounded,filled"
		Author [label=Author]
		Book [label=Book]
		Issue [label=Issue]
		Fine [label=Fine]
		LibraryStat [label=LibraryStat]
		BookRecommendation [label=BookRecommendation]
	}
	subgraph cluster_student {
		color=black fillcolor="#F0F0F0" fontname=Arial fontsize=12 label="Student App" style="rounded,filled"
		Department [label=Department]
		Student [label=Student]
		auth_user [label=auth_user]
	}
	Author -> Book [label=1 arrowhead=none]
	Book -> Issue [label=1 arrowhead=none]
	Issue -> Fine [label="0..1" arrowhead=none]
	Student -> Issue [label=1 arrowhead=none color="#666666" style=dashed]
	Book -> Issue [label=1 arrowhead=none color="#666666" style=dashed]
	Department -> Student [label=1 arrowhead=none]
	auth_user -> Student [label=1 arrowhead=none color="#666666" style=dashed]
}
