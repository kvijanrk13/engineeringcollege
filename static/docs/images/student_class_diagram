digraph student_app {
	bgcolor=white dpi=150 rankdir=TB
	node [color=black fontname=Arial fontsize=10 shape=record]
	edge [color=black fontname=Arial fontsize=9]
	Department [label="{Department|+ id : BigInteger\l+ name : Varchar(200)\l+ __str__() : String\l}"]
	Student [label="{Student|+ id : BigInteger\l+ first_name : Varchar(120)\l+ last_name : Varchar(120)\l+ __str__() : String\l}"]
	auth_user [label="{auth_user|+ id : BigInteger\l+ username : Varchar(150)\l+ password : Varchar(128)\l+ email : Varchar(254)\l+ is_active : Boolean\l+ is_staff : Boolean\l+ is_superuser : Boolean\l+ last_login : DateTime\l+ date_joined : DateTime\l+ __str__() : String\l}"]
	Department -> Student [label=1 arrowhead=none style=solid]
	auth_user -> Student [label=1 arrowhead=none style=dashed]
}
